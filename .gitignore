# Секретные токены и конфигурация
.env
.env.local
.env.*.local

# Виртуальное окружение
.venv/
venv/
env/

# Базы данных SQLite (бинарники не должны попадать в контекст агента)
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite3

# Бэкапы базы данных на сервере
backups/

# Кэш и временные артефакты Python
__pycache__/
*.py[cod]
*$py.class
.booking_data_*.py.tmp

# Настройки IDE (PyCharm / VS Code)
.idea/
.vscode/

# Логи и временные файлы
*.log
saharvosk_catalog.txt

# Сессия мессенджера MAX (личные учётные данные аккаунта)
max_session*

