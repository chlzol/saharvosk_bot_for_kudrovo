[Unit]
Description=Sahar&Vosk Telegram Bot Service (Kudrovo)
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/saharvosk_bot_for_kudrovo
ExecStart=/opt/saharvosk_bot_for_kudrovo/.venv/bin/python main.py
Restart=always
RestartSec=5
Environment=TZ=Europe/Moscow
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
SyslogIdentifier=saharvosk_bot

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
